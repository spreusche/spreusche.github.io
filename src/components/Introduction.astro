---
const personalImageAlt = "Santiago Preusche";
import Badge from "./Badge.astro";
import DownloadButton from "./DownloadButton.astro";
import GithubIcon from "./icons/GithubIcon.astro";
import LinkedInIcon from "./icons/LinkedInIcon.astro";
import MailIcon from "./icons/MailIcon.astro";
import SocialPill from "./SocialPill.astro";
---

<div class="max-w-xl">
    <div class="flex gap-4 mb-4">
        <img
            class="rounded-full shadow-lg size-16"
            src="/spreusche.webp"
            alt={personalImageAlt}
        />
        <a
            href="https://linkedin.com/in/santiagopreusche"
            target="_blank"
            rel="noopener"
            class="flex items-center transition md:justify-center md:hover:scale-105"
        >
            <Badge>Open to Work</Badge>
        </a>
    </div>
    <h1
        class="text-4xl font-bold tracking-tight text-gray-800 sm:text-5xl dark:text-white"
    >
    👋 Hey! I'm Santiago
    </h1>
    <p
        class="mt-6 text-xl text-gray-800 dark:[&>strong]:text-yellow-200 [&>strong]:text-yellow-500 [&>strong]:font-semibold dark:text-gray-300"
    >
    <strong>MSc and Software Engineer</strong> from Buenos Aires, Argentina 🇦🇷, currently based in Austria 🇦🇹.
    With 1+ years of experience in the field I am always looking forward for a new challenge and excited to contribute with all my skills and knowledge while I learn more about technologies and grow as an engineer.
</p>
    <nav class="flex flex-wrap gap-4 mt-8">
        <SocialPill href="mailto:santipreusche@gmail.com">
            <MailIcon class="size-4" />
            santipreusche@gmail.com
        </SocialPill>
        <SocialPill href="https://www.linkedin.com/in/santiagopreusche">
            <LinkedInIcon class="size-4" />
            LinkedIn
        </SocialPill>
        <SocialPill href="https://www.github.com/spreusche">
            <GithubIcon class="size-4" />
            GitHub
        </SocialPill>
    </nav>
    <div class="flex flex-col items-center gap-4 mt-8">
        <DownloadButton />
    </div>
    
</div>
