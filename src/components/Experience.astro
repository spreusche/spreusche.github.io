---
import ExperienceItem from "./ExperienceItem.astro"

    const EXPERIENCE = [
    {
    date: "December 2024 - Present",
    title: "Software Engineer",
    company: "VCE",
    link: "https://www.vce.at/",
    description:
        "Developed a webapp for the analysis and constant monitoring of sensor data on construction sites and buildings.",
    },
    {
    date: "September - November 2023",
    title: "Android Development Internship",
    company: "Runtastic GmbH (adidas)",
    link: "https://www.runtastic.com/",
    description:
        "Joined the android development team to give support and develop features for the Adidas running app. Worked both on the Running and the Adidas apps",
    },
    
    ]
    ---

    <ol class="relative mt-16">
    {
    EXPERIENCE.map((experience) => (
        <li class="">
        <ExperienceItem {...experience} />
        </li>
    ))
    }
    </ol>